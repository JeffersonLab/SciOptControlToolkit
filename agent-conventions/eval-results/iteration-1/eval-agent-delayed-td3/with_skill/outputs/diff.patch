+class TestKerasTD3DelayedAgent(AgentTestMixin, unittest.TestCase):
+    agent_cls = KerasTD3Delayed
+
+
+class TestKerasTD3DelayedActorUpdateGating(unittest.TestCase):
+    """KerasTD3Delayed-specific behavior: the very first actor update must
+    additionally wait for the buffer to reach 2x warmup_size, on top of the
+    normal actor_update_freq gating. After that first update fires, later
+    updates are gated purely by actor_update_freq, same as KerasTD3."""
+
+    def setUp(self):
+        self.env = make_env()
+        self.logdir = tempfile.mkdtemp()
+        self.agent = make_agent(KerasTD3Delayed, self.env, self.logdir,
+                                 buffer_size=10000)
+        # Small, fast-to-fill thresholds so the test doesn't need thousands
+        # of buffer entries. train()/action() only ever read these off
+        # `self`, so overriding them post-construction is safe.
+        self.agent.warmup_size = 5
+        self.agent.batch_size = 5
+        self.agent.actor_update_freq = 1
+        self.agent.critic_update_freq = 1
+
+    def _actor_weights(self):
+        return [w.copy() for w in self.agent.actor_model.get_weights()]
+
+    def test_first_actor_update_withheld_before_2x_warmup(self):
+        # buffer.size() > max(batch_size, warmup_size) == 5, so train()
+        # reaches the actor-update gate, but buffer size (6) is still below
+        # 2 * warmup_size (10) -- the extra delay should hold the actor back
+        # even though actor_update_freq (1) would normally fire every call.
+        for _ in range(6):
+            self.agent.memory(random_transition(self.env))
+
+        before = self._actor_weights()
+        self.agent.train()
+        after = self._actor_weights()
+
+        for b, a in zip(before, after):
+            np.testing.assert_array_almost_equal(b, a)
+        self.assertFalse(self.agent._first_actor_update_done)
+
+    def test_first_actor_update_fires_once_2x_warmup_reached(self):
+        # Fill past warmup but still under the 2x-warmup_size gate.
+        for _ in range(6):
+            self.agent.memory(random_transition(self.env))
+        self.agent.train()
+        self.assertFalse(self.agent._first_actor_update_done)
+
+        # Push the buffer up to 2 * warmup_size (10) -- now the delayed
+        # gate should be satisfied and the actor should finally update.
+        for _ in range(4):
+            self.agent.memory(random_transition(self.env))
+
+        before = self._actor_weights()
+        self.agent.train()
+        after = self._actor_weights()
+
+        changed = any(not np.allclose(b, a) for b, a in zip(before, after))
+        self.assertTrue(changed)
+        self.assertTrue(self.agent._first_actor_update_done)
+
+    def test_later_updates_use_plain_actor_update_freq_after_first_fires(self):
+        # Get past the one-time delayed gate.
+        for _ in range(10):
+            self.agent.memory(random_transition(self.env))
+        self.agent.train()
+        self.assertTrue(self.agent._first_actor_update_done)
+
+        # Now behave exactly like KerasTD3: every train() call updates the
+        # actor again, since actor_update_freq is 1 and the one-time gate no
+        # longer applies.
+        self.agent.memory(random_transition(self.env))
+        before = self._actor_weights()
+        self.agent.train()
+        after = self._actor_weights()
+
+        changed = any(not np.allclose(b, a) for b, a in zip(before, after))
+        self.assertTrue(changed)
+
+
