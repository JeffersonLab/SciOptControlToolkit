+class TestKerasTD3DelayedActorDelay(unittest.TestCase):
+    """KerasTD3Delayed must withhold the very first actor/policy update
+    until the buffer has collected at least `actor_delay_warmup_multiplier`
+    (default 2x) times warmup_size transitions, even once the normal
+    actor_update_freq gate would otherwise allow an update. After that
+    first update fires, it must behave exactly like KerasTD3."""
+
+    def _write_cfg(self, tmpdir, warmup_size=20, batch_size=8,
+                   actor_update_freq=1, critic_update_freq=1,
+                   actor_delay_warmup_multiplier=2.0):
+        cfg_data = {
+            "warmup_size": str(warmup_size),
+            "batch_size": str(batch_size),
+            "critic_learning_rate": "0.0003",
+            "actor_learning_rate": "0.0003",
+            "tau": "0.005",
+            "discount": "0.99",
+            "buffer_type": "ER-v0",
+            "actor_model": "actor_fcnn-v0",
+            "critic_model": "critic_fcnn-v0",
+            "exploration_noise_fraction": "0.1",
+            "actor_update_freq": str(actor_update_freq),
+            "critic_update_freq": str(critic_update_freq),
+            "actor_delay_warmup_multiplier": str(actor_delay_warmup_multiplier),
+        }
+        path = os.path.join(tmpdir, 'keras_td3_delayed_test.cfg')
+        with open(path, 'w') as f:
+            json.dump(cfg_data, f)
+        return path
+
+    def setUp(self):
+        self.env = make_env()
+        self.logdir = tempfile.mkdtemp()
+        cfg_path = self._write_cfg(tempfile.mkdtemp())
+        self.agent = KerasTD3Delayed(
+            env=self.env, logdir=self.logdir, cfg=cfg_path,
+            buffer_type='ER-v0', buffer_size=500)
+
+    def _target_actor_weights_snapshot(self):
+        import tensorflow as tf
+        state = tf.zeros([1, self.env.observation_space.shape[0]])
+        self.agent.actor_model(state)
+        self.agent.target_actor(state)
+        return [w.copy() for w in self.agent.target_actor.get_weights()]
+
+    def test_delay_size_is_2x_warmup_by_default(self):
+        self.assertEqual(self.agent.actor_delay_size, 2 * self.agent.warmup_size)
+
+    def test_actor_update_withheld_before_2x_warmup(self):
+        # Fill buffer past warmup_size/batch_size (so train() proceeds) but
+        # below the 2x warmup_size actor-delay threshold.
+        for _ in range(self.agent.warmup_size + self.agent.batch_size + 1):
+            self.agent.memory(random_transition(self.env))
+        self.assertLess(self.agent.buffer.size(), self.agent.actor_delay_size)
+
+        before = self._target_actor_weights_snapshot()
+        self.agent.train()
+        after = self.agent.target_actor.get_weights()
+
+        self.assertFalse(self.agent._actor_delay_lifted)
+        for b, a in zip(before, after):
+            np.testing.assert_array_almost_equal(b, a)
+
+    def test_actor_update_fires_after_2x_warmup(self):
+        # Fill buffer past the 2x warmup_size actor-delay threshold.
+        for _ in range(self.agent.actor_delay_size + self.agent.batch_size + 1):
+            self.agent.memory(random_transition(self.env))
+        self.assertGreaterEqual(self.agent.buffer.size(), self.agent.actor_delay_size)
+
+        before = self._target_actor_weights_snapshot()
+        self.agent.train()
+        after = self.agent.target_actor.get_weights()
+
+        self.assertTrue(self.agent._actor_delay_lifted)
+        changed = any(not np.allclose(b, a) for b, a in zip(before, after))
+        self.assertTrue(changed)
+
+    def test_delay_only_gates_first_update(self):
+        # Once lifted, the flag must stay lifted even if called again.
+        for _ in range(self.agent.actor_delay_size + self.agent.batch_size + 1):
+            self.agent.memory(random_transition(self.env))
+        self.agent.train()
+        self.assertTrue(self.agent._actor_delay_lifted)
+        self.agent.train()
+        self.assertTrue(self.agent._actor_delay_lifted)
+
 
 if __name__ == '__main__':
     unittest.main()
