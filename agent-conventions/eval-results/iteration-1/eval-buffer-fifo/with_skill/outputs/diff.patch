+def tagged_transition(i):
+    """A transition whose reward is tagged with `i`, so tests can assert
+    exactly which recorded experiences a buffer's sample() returns."""
+    state      = np.random.randn(STATE_DIM).astype(np.float32)
+    action     = np.random.randn(ACTION_DIM).astype(np.float32)
+    reward     = float(i)
+    next_state = np.random.randn(STATE_DIM).astype(np.float32)
+    done       = 0.0
+    priority   = 1.0
+    return (state, action, reward, next_state, done, priority)
+
+
 def zero_transition():
     """A fully valid experience where every field is zero."""
     state      = np.zeros(STATE_DIM, dtype=np.float32)
@@ -372,5 +390,146 @@ class TestPERBuffer(unittest.TestCase):
                          action_dim=ACTION_DIM, logdir=self.logdir)
 
 
+class TestFIFOBuffer(unittest.TestCase):
+
+    def setUp(self):
+        self.logdir = tempfile.mkdtemp()
+        self.buf = make_fifo(self.logdir)
+
+    # --- size tracking (inherited from ER) ---
+
+    def test_size_starts_at_zero(self):
+        self.assertEqual(self.buf.size(), 0)
+
+    def test_size_increments_on_record(self):
+        for i in range(1, 11):
+            self.buf.record(random_transition())
+            self.assertEqual(self.buf.size(), i)
+
+    def test_size_caps_at_capacity(self):
+        for _ in range(BUFFER_SIZE + 20):
+            self.buf.record(random_transition())
+        self.assertEqual(self.buf.size(), BUFFER_SIZE)
+
+    # --- circular overwrite (inherited from ER) ---
+
+    def test_circular_overwrite(self):
+        sentinel = np.ones(STATE_DIM, dtype=np.float32) * 99.0
+        for _ in range(BUFFER_SIZE):
+            self.buf.record(random_transition())
+        # Write one more — should overwrite index 0
+        self.buf.record((sentinel, np.zeros(ACTION_DIM), 0.0,
+                         np.zeros(STATE_DIM), 0.0, 1.0))
+        np.testing.assert_array_almost_equal(self.buf.states[0], sentinel)
+
+    # --- record / sample shapes ---
+
+    def test_sample_shapes(self):
+        for _ in range(50):
+            self.buf.record(random_transition())
+        states, actions, rewards, next_states, dones, weights = self.buf.sample(10)
+        self.assertEqual(states.shape,      (10, STATE_DIM))
+        self.assertEqual(actions.shape,     (10, ACTION_DIM))
+        self.assertEqual(rewards.shape,     (10, 1))
+        self.assertEqual(next_states.shape, (10, STATE_DIM))
+        self.assertEqual(dones.shape,       (10, 1))
+        self.assertEqual(weights.shape,     (10,))
+
+    def test_sample_does_not_exceed_buffer_size(self):
+        for _ in range(5):
+            self.buf.record(random_transition())
+        # Should not raise even though 10 > 5
+        states, _, _, _, _, _ = self.buf.sample(10)
+        self.assertEqual(len(states), 5)
+
+    # --- the behaviour that actually distinguishes FIFO from ER ---
+
+    def test_sample_returns_most_recent_no_wraparound(self):
+        for i in range(20):
+            self.buf.record(tagged_transition(i))
+        _, _, rewards, _, _, _ = self.buf.sample(5)
+        # Oldest-to-newest ordering of the 5 most recently recorded tags.
+        self.assertEqual(rewards.flatten().tolist(), [15.0, 16.0, 17.0, 18.0, 19.0])
+
+    def test_sample_returns_most_recent_with_wraparound(self):
+        # BUFFER_SIZE=100; record 103 tagged transitions (tags 0..102), so
+        # the write pointer wraps past the end of the underlying arrays.
+        for i in range(BUFFER_SIZE + 3):
+            self.buf.record(tagged_transition(i))
+        _, _, rewards, _, _, _ = self.buf.sample(5)
+        # The 5 most recent tags are 98..102; buffer indices 98,99 wrap
+        # around to 0,1,2, so this also exercises the modulo arithmetic.
+        self.assertEqual(rewards.flatten().tolist(), [98.0, 99.0, 100.0, 101.0, 102.0])
+
+    def test_sample_is_deterministic(self):
+        """Unlike ER's random draw, repeated calls with no new records
+        between them return the exact same experiences."""
+        for i in range(30):
+            self.buf.record(tagged_transition(i))
+        _, _, rewards1, _, _, _ = self.buf.sample(10)
+        _, _, rewards2, _, _, _ = self.buf.sample(10)
+        np.testing.assert_array_equal(rewards1, rewards2)
+
+    def test_sample_counts_only_most_recent(self):
+        for i in range(20):
+            self.buf.record(tagged_transition(i))
+        self.buf.sample(5)
+        expected = np.zeros((BUFFER_SIZE, 1))
+        expected[15:20] = 1
+        np.testing.assert_array_equal(self.buf.sample_counts, expected)
+
+    # --- save / load (inherited from ER, including the pointer) ---
+
+    def test_save_and_load(self):
+        for _ in range(30):
+            self.buf.record(random_transition())
+        filepath = os.path.join(self.logdir, 'replay.npy')
+        self.buf.save(filepath)
+        self.assertTrue(os.path.exists(filepath))
+
+        buf2 = make_fifo(self.logdir)
+        buf2.load(filepath)
+        np.testing.assert_array_equal(self.buf.states, buf2.states)
+        np.testing.assert_array_equal(self.buf.actions, buf2.actions)
+
+    def test_save_and_load_preserves_pointer(self):
+        for _ in range(30):
+            self.buf.record(random_transition())
+        filepath = os.path.join(self.logdir, 'replay.npy')
+        self.buf.save(filepath)
+
+        buf2 = make_fifo(self.logdir)
+        buf2.load(filepath)
+        self.assertEqual(buf2.pointer, 30)
+        self.assertEqual(buf2.size(), 30)
+
+    def test_save_and_load_wrapped_buffer_preserves_pointer(self):
+        overflow = 15
+        total = BUFFER_SIZE + overflow
+        for _ in range(total):
+            self.buf.record(random_transition())
+        filepath = os.path.join(self.logdir, 'replay.npy')
+        self.buf.save(filepath)
+
+        buf2 = make_fifo(self.logdir)
+        buf2.load(filepath)
+        self.assertEqual(buf2.pointer, total)
+        self.assertEqual(buf2.size(), BUFFER_SIZE)
+
+    # --- cfg save ---
+
+    def test_save_cfg(self):
+        self.buf.save_cfg()
+        cfg_path = os.path.join(self.logdir, 'cfgs', 'fifo.cfg')
+        self.assertTrue(os.path.exists(cfg_path))
+
+    # --- registry ---
+
+    def test_registry_fifo(self):
+        buf = buffers.make('FIFO-v0', state_dim=STATE_DIM,
+                           action_dim=ACTION_DIM, logdir=self.logdir)
+        self.assertIsInstance(buf, FIFO)
+
+
 if __name__ == '__main__':
     unittest.main()
