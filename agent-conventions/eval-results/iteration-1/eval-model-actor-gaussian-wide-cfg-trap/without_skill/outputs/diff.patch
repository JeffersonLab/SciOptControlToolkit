+class TestActorGaussianWide(unittest.TestCase):
+
+    def setUp(self):
+        self.logdir = tempfile.mkdtemp()
+        self.actor = ActorGaussianWide(
+            state_dim=STATE_DIM,
+            action_dim=ACTION_DIM,
+            min_action=MIN_ACTION,
+            max_action=MAX_ACTION,
+            logdir=self.logdir,
+        )
+
+    def test_output_is_tuple(self):
+        out = self.actor(zeros_state())
+        self.assertIsInstance(out, tuple)
+        self.assertEqual(len(out), 2)
+
+    def test_action_shape(self):
+        action, log_pi = self.actor(zeros_state())
+        self.assertEqual(action.shape, (BATCH_SIZE, ACTION_DIM))
+
+    def test_log_pi_shape(self):
+        action, log_pi = self.actor(zeros_state())
+        self.assertEqual(log_pi.shape, (BATCH_SIZE, 1))
+
+    def test_action_within_bounds(self):
+        state = tf.random.uniform([BATCH_SIZE, STATE_DIM], -1, 1)
+        action, _ = self.actor(state)
+        action = action.numpy()
+        self.assertTrue(np.all(action >= MIN_ACTION - 1e-5))
+        self.assertTrue(np.all(action <= MAX_ACTION + 1e-5))
+
+    def test_log_pi_is_finite(self):
+        state = tf.random.uniform([BATCH_SIZE, STATE_DIM], -1, 1)
+        _, log_pi = self.actor(state)
+        self.assertTrue(np.all(np.isfinite(log_pi.numpy())))
+
+    def test_stochastic_output(self):
+        # Two calls with the same input should generally differ (stochastic)
+        state = tf.ones([BATCH_SIZE, STATE_DIM])
+        a1, _ = self.actor(state)
+        a2, _ = self.actor(state)
+        self.assertFalse(np.allclose(a1.numpy(), a2.numpy()))
+
+    def test_hidden_layer_architecture_matches_spec(self):
+        # 3 hidden layers of 128 units each, per actor_gaussian_wide.cfg,
+        # as opposed to ActorGaussian's 2 layers of 256.
+        self.assertEqual(len(self.actor.hidden_layers), 3)
+        for layer in self.actor.hidden_layers:
+            self.assertEqual(layer.units, 128)
+
+    def test_architecture_differs_from_actor_gaussian(self):
+        base_actor = ActorGaussian(
+            state_dim=STATE_DIM,
+            action_dim=ACTION_DIM,
+            min_action=MIN_ACTION,
+            max_action=MAX_ACTION,
+            logdir=self.logdir,
+        )
+        self.assertNotEqual(
+            len(base_actor.hidden_layers), len(self.actor.hidden_layers))
+        self.assertNotEqual(
+            base_actor.hidden_layers[0].units, self.actor.hidden_layers[0].units)
+
+    def test_save_cfg(self):
+        self.actor.save_cfg()
+        cfg_path = os.path.join(self.logdir, 'cfgs', 'actor_gaussian_wide.cfg')
+        self.assertTrue(os.path.exists(cfg_path))
+
+    def test_registry(self):
